{
  "name": "robopy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "validate": "vitest run tests/content",
    "e2e": "playwright test",
    "pages:dev": "wrangler pages dev dist --d1 DB --binding ENVIRONMENT=dev --binding DEV_FAKE_USER=dev@localhost"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@mujoco/mujoco": "3.16.0",
    "preact": "10.29.8",
    "pyodide": "314.0.7",
    "three": "0.186.1",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "jose": "6.2.12",
    "katex": "0.19.0",
    "marked": "18.0.14",
    "meshoptimizer": "1.0.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  }
